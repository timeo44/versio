# ─────────────────────────────────────────────────────────────
# Versio — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── Spotify (required) ───────────────────────────────────────
# Public Client ID from https://developer.spotify.com/dashboard
# PKCE flow → NO client secret is needed or used anywhere.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Must match a Redirect URI in your Spotify app settings EXACTLY.
# Spotify does not accept "localhost" — use the loopback IP locally.
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# ── Translation (one of the two is required) ─────────────────
# "openai" | "deepl". If empty, picks openai when OPENAI_API_KEY
# is set, otherwise deepl.
TRANSLATION_PROVIDER=openai

# OpenAI — context-aware translation + line explanations (recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: any OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepL — fast, high quality, but no line explanations
# Keys ending in ":fx" automatically use the free API host.
DEEPL_API_KEY=
# Optional override, e.g. https://api-free.deepl.com
DEEPL_API_URL=

# ── Lyrics (LRCLIB, no key needed) ───────────────────────────
LRCLIB_BASE_URL=https://lrclib.net
# LRCLIB asks clients to identify themselves.
LRCLIB_USER_AGENT=Versio/1.0 (https://github.com/your-name/versio)

# ── Supabase (optional — cloud sync for the vocabulary list) ─
# Without these, vocabulary is stored in the browser only.
# Server-only: the service role key is never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
