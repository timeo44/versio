# ─────────────────────────────────────────────────────────────
# Versio — LOCAL development (.env.local)
# Production values live in GitHub (Settings → Secrets and
# variables → Actions), see README → Deploy.
# ─────────────────────────────────────────────────────────────

# ── Frontend ─────────────────────────────────────────────────
# Spotify Client ID (public — PKCE, no client secret anywhere)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Must match a Redirect URI in your Spotify app EXACTLY. No "localhost".
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
# API base URL. Leave empty locally (npm run dev starts it on :8787).
NEXT_PUBLIC_API_URL=

# ── API (server-only; read by scripts/dev-api.ts) ────────────
TRANSLATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPL_API_KEY=

LRCLIB_USER_AGENT=Versio/1.0 (https://github.com/your-name/versio)

# Optional locally: user management, limits, vocabulary sync.
# Without them, any Spotify account that can log in gets full access.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SPOTIFY_IDS=
